{
  "manifest_version": 3,
  "name": "İlan Tarayıcı",
  "description": "Kendi ilanların taranıp SQL veritabanına kaydeder.",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.*********.com/"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": []
}
